# OpenMemory API Environment Variables

# User Configuration (for backward compatibility with existing setups)
USER=default_user
API_KEY=your-api-key-here

# Authentication Configuration
AUTH_ENABLED=true

# Keycloak Authentication Configuration
KEYCLOAK_SERVER_URL=http://localhost:8080
KEYCLOAK_REALM=openmemory
KEYCLOAK_CLIENT_ID=openmemory-api
KEYCLOAK_CLIENT_SECRET=your-client-secret-here

# Database Configuration (if using external database)
DATABASE_URL=sqlite:///./mem0.db

# API Configuration
NEXT_PUBLIC_URL=http://localhost:8765
LOG_LEVEL=INFO

# Memory Storage Configuration
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# LLM Configuration (example for OpenAI)
OPENAI_API_KEY=sk-xxx
OPENAI_MODEL=gpt-4

# Vector Store Configuration
VECTOR_STORE=qdrant
VECTOR_STORE_URL=http://localhost:6333

# Graph Store Configuration (optional)
GRAPH_STORE=neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=password