# Certbot Azure Configuration Example
# Copy this file to .env and fill in your values

# Certificate Configuration
CERTMGR_DOMAIN=example.com
CERTMGR_EMAIL=admin@example.com

# DNS Provider Configuration
# Set DNS provider tokens - at least one is required
# The system will auto-detect the provider based on domain nameservers
CERTMGR_DESEC_TOKEN=your_desec_api_token_here
CERTMGR_CLOUDFLARE_TOKEN=your_cloudflare_api_token_here

# Optional: Explicitly set DNS provider (auto-detect if not specified)
# CERTMGR_DNS_PROVIDER=auto  # Options: auto, desec, cloudflare

# Azure Configuration
CERTMGR_AZURE_TENANT_ID=your_azure_tenant_id
CERTMGR_AZURE_CLIENT_ID=your_azure_client_id
CERTMGR_AZURE_CLIENT_SECRET=your_azure_client_secret
CERTMGR_AZURE_KEYVAULT_NAME=your_keyvault_name
CERTMGR_AZURE_CERT_NAME=your_certificate_name

# Optional Configuration
CERTMGR_RENEWAL_MODE=false
CERTMGR_STAGING=false
CERTMGR_KEEPALIVE=false
